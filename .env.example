# ==============================================================================
# DefenceLogix AI — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER-ONLY SECRETS (Never expose to client or frontend bundle)
# ------------------------------------------------------------------------------

# JWT_SECRET: Secret key used to sign and verify HMAC-SHA256 authentication tokens.
# Required in production. Generate a strong random 32+ character string.
JWT_SECRET=

# GEMINI_API_KEY: Optional API key for LogiAI tactical assistant via Google Gemini API.
# If omitted, LogiAI uses rule-based operational fallback responses.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# SERVER RUNTIME CONFIGURATION (Optional)
# ------------------------------------------------------------------------------

# PORT: Server listening port (defaults to 3000 in local dev)
PORT=

# NODE_ENV: Application environment ('production' or 'development')
NODE_ENV=

# ------------------------------------------------------------------------------
# CLIENT-SAFE VARIABLES (VITE_*)
# ------------------------------------------------------------------------------
# None required. The frontend communicates with relative '/api/*' endpoints,
# ensuring zero client-side secret exposure across development and production.

